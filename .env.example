# =========================================================
# Airflow / Docker Compose
# =========================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow 3.x 컴포넌트가 함께 사용하는 JWT secret.
# 운영에서는 충분히 긴 무작위 문자열을 설정한다.
AIRFLOW__API_AUTH__JWT_SECRET=

# CI가 ECR에 push한 이미지 주소. 비우면 로컬에서 Dockerfile을 빌드한다.
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/three-idiots-airflow:latest
AIRFLOW_IMAGE=

# =========================================================
# 실행 환경 / AWS
# =========================================================
# "aws": S3, RDS, Spark 클러스터 사용
# "local": 로컬 디스크, SQLite, Spark local[*] 사용
APP_ENV=aws

AWS_REGION=ap-northeast-2
S3_BUCKET_DATA=

# Type 3 요일별 승차 수요 평균에 사용할 최근 주 수
TLC_TYPE3_ROLLING_WEEKS=12

# =========================================================
# RDS (세그먼트 지표 서빙 테이블) — DynamoDB 사용 중단으로 전환
# =========================================================
# 비워두면 docker-compose가 로컬 postgres 서비스(POSTGRES_*)를 그대로
# 재사용한다 — 새 RDS 인스턴스 없이 로컬 개발이 가능하다. 운영에서는
# 실제 RDS 엔드포인트/자격증명으로 채운다.
RDS_HOST=
RDS_PORT=
RDS_DB=
RDS_USER=
RDS_PASSWORD=

# 비워두면 docker-compose가 segment_metrics_type1/2/3/4로 자동 대체
SERVING_TABLE_TYPE1=
SERVING_TABLE_TYPE2=
SERVING_TABLE_TYPE3=
SERVING_TABLE_TYPE4=

# =========================================================
# 서빙 API 튜닝 (RDS 폴백 체인 — 값 하나 조정에 재배포가 필요 없도록
# config.py가 여기서 읽는다. 아래는 전부 실측 전 정성적 초안 기본값이라
# CloudWatch 데이터가 쌓이면 조정이 필요할 수 있다)
# =========================================================
# RDS 자체 장애 시 fallback으로 넘어가기까지 기다리는 시간
# (nav_lookup.py type1/2, api.py type3가 공유)
SERVING_RDS_CONNECT_TIMEOUT_SECONDS=1
SERVING_RDS_STATEMENT_TIMEOUT_MS=1000

# nav_lookup.py의 RDS 장애 대비 인메모리 캐시 최대 항목 수
SERVING_MEMORY_CACHE_MAX_SIZE=50000

# RDS/캐시/스냅샷까지 전부 실패했을 때 쓰는 최후의 상수
# (scripts/seed_rds_defaults.py의 기본값과 맞춰야 함)
SERVING_HARDCODED_DEFAULT_TYPE1_SECONDS=45
SERVING_HARDCODED_DEFAULT_TYPE2_METERS=300

# api.py(type3)의 RDS 배치 조회 단위 / 요청당 segment_id 최대 개수
TYPE3_RDS_BATCH_SIZE=100
MAX_SEGMENTS_PER_REQUEST=1000

# S3 Gold 스냅샷(gold_snapshot.py) 읽기/쓰기 타임아웃
GOLD_SNAPSHOT_S3_CONNECT_TIMEOUT_SECONDS=1
GOLD_SNAPSHOT_S3_READ_TIMEOUT_SECONDS=1

# nav_time/gold2.py의 type1 세그먼트 평균 증분 갱신 스무딩 윈도우
NAV_TIME_AVG_SMOOTHING_WINDOW=10

# =========================================================
# EMR Serverless
# =========================================================
# 세그먼트 지표 파이프라인 Spark 잡 실행 대상
# 의존성 패키징은 scripts/package_emr_dependencies.sh로 별도 실행 필요
EMR_APPLICATION_ID=
EMR_JOB_ROLE_ARN=

# =========================================================
# 장애 알림
# =========================================================
# Slack Incoming Webhook URL. 운영 EC2에서는 반드시 실제 값을 설정한다.
SLACK_WEBHOOK_URL=

# =========================================================
# Grafana (모니터링 대시보드)
# =========================================================
# CloudWatch 데이터소스는 EC2 인스턴스 IAM 롤(CloudWatchReadOnlyAccess)을
# 그대로 쓰므로 별도 AWS 키가 필요 없다 - 여기 아래 두 값만 채우면 된다.
# GRAFANA_ADMIN_PASSWORD는 비워두면 컨테이너가 기동을 거부한다(기본값
# admin/admin으로 공개 노출되는 걸 막기 위함).
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=
