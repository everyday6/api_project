# =========================================================
# Airflow / Docker Compose
# =========================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow 3.x 컴포넌트가 함께 사용하는 JWT secret.
# 운영에서는 충분히 긴 무작위 문자열을 설정한다.
AIRFLOW__API_AUTH__JWT_SECRET=

# CI가 ECR에 push한 이미지 주소. 비우면 로컬에서 Dockerfile을 빌드한다.
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/three-idiots-airflow:latest
AIRFLOW_IMAGE=

# =========================================================
# 실행 환경 / AWS
# =========================================================
# "aws": S3, DynamoDB, Spark 클러스터 사용
# "local": 로컬 디스크, SQLite, Spark local[*] 사용
APP_ENV=aws

AWS_REGION=ap-northeast-2
S3_BUCKET_DATA=

# Type 3 요일별 승차 수요 평균에 사용할 최근 주 수
TLC_TYPE3_ROLLING_WEEKS=12

# =========================================================
# RDS
# =========================================================
RDS_HOST=
RDS_PORT=
RDS_DB=
RDS_USER=
RDS_PASSWORD=

# =========================================================
# EMR Serverless
# =========================================================
# 세그먼트 지표 파이프라인 Spark 잡 실행 대상
# 의존성 패키징은 scripts/package_emr_dependencies.sh로 별도 실행 필요
EMR_APPLICATION_ID=
EMR_JOB_ROLE_ARN=

# =========================================================
# DynamoDB
# =========================================================
# 비워두면 docker-compose가 SegmentMetricsType1/2/3/4로 자동 대체
DYNAMODB_TABLE_TYPE1=
DYNAMODB_TABLE_TYPE2=
DYNAMODB_TABLE_TYPE3=
DYNAMODB_TABLE_TYPE4=

# =========================================================
# 장애 알림
# =========================================================
# Slack Incoming Webhook URL. 운영 EC2에서는 반드시 실제 값을 설정한다.
SLACK_WEBHOOK_URL=