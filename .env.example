TICKETMASTER_API_KEY=
AIRFLOW_JWT_SECRET=

# "local" | "aws" (기본값 aws). local이면 S3/RDS/Spark 클러스터 대신
# 로컬 디스크(data/bronze 등)+SQLite(data/local_serving.db)+Spark local[*]로
# 돈다 — 개발 컴퓨터에서 AWS 자격증명/네트워크 없이 파이프라인을 돌려볼 때만
# 켠다. EC2에는 이 값을 절대 넣지 않는다(기본값 aws로 둬야 지금과 동일하게 동작).
APP_ENV=

# CI(GitHub Actions)가 ECR에 push해둔 이미지 경로. 비워두면 로컬에서
# Dockerfile을 직접 빌드한다. 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/three-idiots-airflow:latest
AIRFLOW_IMAGE=

AWS_REGION=
S3_BUCKET_DATA=
S3_BUCKET_DASHBOARD=

RDS_HOST=
RDS_PORT=
RDS_DB=
RDS_USER=
RDS_PASSWORD=

# EMR Serverless — 세그먼트 지표 파이프라인 Spark 잡 실행 대상
# 의존성 패키징은 scripts/package_emr_dependencies.sh로 별도 실행 필요
# (requirements.txt 변경 시).
EMR_APPLICATION_ID=
EMR_JOB_ROLE_ARN=

# DynamoDB 테이블명 (비워두면 docker-compose가 SegmentMetricsType1/2로 자동 대체)
DYNAMODB_TABLE_TYPE1=
DYNAMODB_TABLE_TYPE2=