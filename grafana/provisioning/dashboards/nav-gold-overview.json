          "datasource": {
            "type": "postgres",
            "uid": "rds-postgres"
          },
          "format": "table",
          "editorMode": "code",
          "rawSql": "SELECT 'type1' AS type, COUNT(*) AS row_count, MAX(last_sample_at) AS last_sample_at, ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(last_sample_at))) / 3600, 1) AS hours_since_last_sample, MAX(updated_date) AS updated_date FROM segment_metrics_type1 UNION ALL SELECT 'type2', COUNT(*), NULL, NULL, MAX(updated_date) FROM segment_metrics_type2 UNION ALL SELECT 'type3', (SELECT reltuples::bigint FROM pg_class WHERE relname = 'segment_metrics_type3'), NULL, NULL, NULL UNION ALL SELECT 'type4', COUNT(*), NULL, NULL, MAX(updated_date) FROM segment_metrics_type4"
        }
      ],
