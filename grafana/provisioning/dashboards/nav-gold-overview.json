      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "dimensions": { "DBInstanceIdentifier": "nav-segment-serving" },
          "statistic": "Average",
          "region": "default"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
